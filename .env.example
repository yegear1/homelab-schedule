# Copie para `.env` e preencha. NUNCA commite `.env`.

# --- App ---
ENV=development
SERVICE_NAME=homelab-schedule
APP=homelab-schedule
LOG_FORMAT=json
NO_COLOR=1
TZ=America/Sao_Paulo
APP_PORT=8003

# Auth da API deste serviço (header x-api-key). Não é a chave do gateway de envio.
SCHEDULE_API_KEY=change_me_schedule_api_key

# URL que o MCP stdio usa para falar com esta API (processo separado).
SCHEDULE_API_URL=http://localhost:8003

# --- Persistência & Retenção ---
DATABASE_PATH=./data/schedule.sqlite
ROUTINES_PATH=./routines.yaml
# Retenção de histórico em dias para expurgo automático de jobs antigos (default: 365; 0 desativa)
JOB_RETENTION_DAYS=365

# --- Gateway de envio (POST /send) ---
WHATSAPP_API_URL=http://localhost:8001
WHATSAPP_API_KEY=change_me_send_gateway_api_key

# Aliases de destino (nome → id). `eu` é o default do MCP/HTTP se `to` omitido.
# Formato: nome=id, separados por vírgula.
# Ex: eu=15551234567
WHATSAPP_ALIASES=eu=15551234567

# Notificação de falhas críticas/dead-letter ao operador (número ou alias, ex: eu ou 5511999998888)
# Se vazio, notificações de dead-letter ficam desativadas.
WHATSAPP_ADMIN_NUMBER=
