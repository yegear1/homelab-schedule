# Copie para `.env` e preencha. NUNCA commite `.env`.

# --- App ---
ENV=development
SERVICE_NAME=homelab-schedule
APP=homelab-schedule
LOG_FORMAT=json
NO_COLOR=1
TZ=America/Sao_Paulo
APP_PORT=8002

# Auth da API deste serviço (header x-api-key). Não é a chave do gatekeeper.
SCHEDULE_API_KEY=change_me_schedule_api_key

# URL que o MCP stdio usa para falar com esta API (processo separado).
SCHEDULE_API_URL=http://localhost:8002

# --- Persistência & Retenção ---
DATABASE_PATH=./data/schedule.sqlite
ROUTINES_PATH=./routines.yaml
# Retenção de histórico em dias para expurgo automático de jobs antigos (default: 365; 0 desativa)
JOB_RETENTION_DAYS=365

# --- WhatsApp gatekeeper (whatsapp-api) ---
WHATSAPP_API_URL=http://localhost:8001
WHATSAPP_API_KEY=change_me_whatsapp_api_key

# Aliases de destino (nome → JID). `eu` é o default do MCP/HTTP se `to` omitido.
# Formato: nome=jid, separados por vírgula.
# Ex: eu=5511999998888@c.us,grupo-homelab=1203630...@g.us
WHATSAPP_ALIASES=eu=5511999998888@c.us
