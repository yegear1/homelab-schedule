# Copy to `.env` and fill in values. NEVER commit `.env`.

# --- Application ---
ENV=development
SERVICE_NAME=homelab-schedule
APP=homelab-schedule
LOG_FORMAT=json
NO_COLOR=1
TZ=America/Sao_Paulo
APP_PORT=8003
HOMELAB_SCHEDULE_VERSION=latest

# API authentication for this service (header `x-api-key`). Not the gateway key.
SCHEDULE_API_KEY=change_me_schedule_api_key

# Base URL used by stdio MCP to communicate with the local HTTP daemon.
SCHEDULE_API_URL=http://localhost:8003

# --- Persistence & Retention ---
DATABASE_PATH=./data/schedule.sqlite
ROUTINES_PATH=./routines.yaml
# History retention in days for automatic purging of completed jobs (default: 365; 0 disables)
JOB_RETENTION_DAYS=365

# --- Dispatch Gateway (POST /send) ---
WHATSAPP_API_URL=http://localhost:8001
WHATSAPP_API_KEY=change_me_send_gateway_api_key

# Destination aliases (alias=phone/jid). `eu` is default if `to` is omitted.
# Format: comma-separated name=id pairs.
# Example: eu=15551234567
WHATSAPP_ALIASES=eu=15551234567

# Operator dead-letter notifications for critical failures (number or alias, e.g. eu or 5511999998888).
# If empty, operator failure notifications are disabled.
WHATSAPP_ADMIN_NUMBER=
